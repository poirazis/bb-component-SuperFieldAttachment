{
  "type": "component",
  "metadata": {
    "svelteMajor": 5
  },
  "schema": {
    "name": "bb-component-SuperFieldAttachment",
    "friendlyName": "Super Field - Attachment",
    "description": "An Attachmen Field component for Budibase",
    "icon": "ABC",
    "requiredAncestors": [
      "form"
    ],
    "block": true,
    "ejectable": false,
    "context": [
      {
        "type": "static",
        "values": [
          {
            "label": "Value",
            "key": "value",
            "type": "string"
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "field/attachment_single",
        "label": "Field",
        "key": "field",
        "required": true
      },
      {
        "type": "text",
        "label": "Label",
        "key": "label"
      },
      {
        "type": "text",
        "label": "Placeholder",
        "key": "placeholder"
      },
      {
        "type": "text",
        "label": "Default value",
        "key": "defaultValue",
        "supportsConditions": false
      },
      {
        "type": "text",
        "label": "Help text",
        "key": "helpText"
      },
      {
        "type": "validation/string",
        "label": "Validation",
        "key": "validation"
      },
      {
        "type": "event",
        "label": "On change",
        "key": "onChange"
      },
      {
        "type": "boolean",
        "label": "Grab Focus",
        "key": "autofocus",
        "defaultValue": false
      },
      {
        "type": "boolean",
        "label": "Disabled",
        "key": "disabled",
        "defaultValue": false
      },
      {
        "type": "boolean",
        "label": "Read only",
        "key": "readonly",
        "defaultValue": false,
        "dependsOn": {
          "setting": "disabled",
          "value": true,
          "invert": true
        }
      },
      {
        "type": "componentConfiguration",
        "componentType": "plugin/bb-component-SuperButton",
        "key": "buttons",
        "nested": true,
        "wide": true
      },
      {
        "tag": "style",
        "type": "select",
        "label": "Label Position",
        "key": "labelPosition",
        "showInBar": true,
        "barStyle": "buttons",
        "defaultValue": "fieldGroup",
        "options": [
          {
            "label": "Disabled",
            "value": false,
            "barIcon": "Cancel",
            "barTitle": "Disabled"
          },
          {
            "label": "Auto",
            "value": "fieldGroup",
            "barIcon": "Group",
            "barTitle": "Field Group"
          },
          {
            "label": "Above",
            "value": "above",
            "barIcon": "MarginTop",
            "barTitle": "Above"
          },
          {
            "label": "Left",
            "value": "left",
            "barIcon": "MarginLeft",
            "barTitle": "Left"
          }
        ]
      },
      {
        "tag": "style",
        "type": "select",
        "key": "role",
        "label": "Field Mode",
        "defaultValue": "formInput",
        "options": [
          {
            "label": "Form Input",
            "value": "formInput"
          },
          {
            "label": "Inline Input",
            "value": "inlineInput"
          }
        ]
      },
      {
        "tag": "style",
        "type": "number",
        "label": "Size",
        "key": "span",
        "defaultValue": 6,
        "min": 2
      },
      {
        "tag": "style",
        "type": "boolean",
        "key": "invisible",
        "label": "Invisible",
        "defaultValue": false
      }
    ]
  }
}
